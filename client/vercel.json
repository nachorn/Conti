{
  "headers": [
    {
      "source": "/connect",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/game",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/room/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://va.vercel-scripts.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://conti-server.onrender.com wss://conti-server.onrender.com https://vitals.vercel-insights.com https://vitals.vercel-analytics.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; upgrade-insecure-requests" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "conti.nrnplay.com" }],
      "destination": "/conti/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pocha.nrnplay.com" }],
      "destination": "/pocha/index.html"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://conti-server.onrender.com/api/admin/:path*"
    },
    {
      "source": "/connect",
      "destination": "/index.html"
    },
    {
      "source": "/conti",
      "destination": "/conti/index.html"
    },
    {
      "source": "/pocha",
      "destination": "/pocha/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/"
    },
    {
      "source": "/room/:roomId",
      "destination": "/"
    },
    {
      "source": "/game",
      "destination": "/"
    }
  ]
}

