# Private /etc/nrnplay/backup.env: nrn:nrn, 0600, directory 0700.
NODE_ENV=production
NRN_STORAGE_MODE=file
GAME_STATE_PATH=/var/lib/nrnplay/games.json
MEMBERSHIP_STATE_PATH=/var/lib/nrnplay/memberships.json
# Existing Neon Free direct URL with verified TLS. No new database or paid plan.
DATABASE_URL=
# Preserve the existing account auth key exactly; no new seed or rotation.
MEMBERSHIP_AUTH_SECRET=
