# Example only. Set real values in the game server environment, never VITE_*.
# Accounts require a verified email sender, an auth secret and durable storage.
# Payments and advertising are optional; leave their settings disabled until validated.
MEMBERSHIP_ENABLED=false
MEMBERSHIP_AUTH_SECRET=
PUBLIC_APP_URL=https://nrnplay.com

# Optional exact game origins for one-use central sign-in. Omitting this uses
# football/conti/pocha.nrnplay.com, footballchampion.net and nrnplay.com.
# MEMBERSHIP_GAME_ORIGINS=https://football.nrnplay.com,https://conti.nrnplay.com,https://pocha.nrnplay.com,https://footballchampion.net,https://nrnplay.com
# Also add the game origins to CLIENT_ORIGINS, preserving existing entries.

# Reuse the existing durable DATABASE_URL and private ADMIN_DASHBOARD_KEY.
# Optional persistent file alternative (must differ from GAME_STATE_PATH):
# MEMBERSHIP_STATE_PATH=/data/memberships.json

# Resend sends transactional codes from the verified NRNPlay domain.
# Create a sending-access-only API key restricted to nrnplay.com.
MEMBERSHIP_EMAIL_PROVIDER=resend
RESEND_API_KEY=
MEMBERSHIP_EMAIL_FROM="NRNPlay <no-reply@nrnplay.com>"
MEMBERSHIP_EMAIL_REPLY_TO=nacho@nrnplay.com
MEMBERSHIP_EMAIL_BRAND=NRNPlay

# Optional Gmail alternative, only when MEMBERSHIP_EMAIL_PROVIDER=gmail.
# Authorize only https://www.googleapis.com/auth/gmail.send with offline access.
# External OAuth apps in Testing receive refresh tokens that expire after 7 days.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GMAIL_SENDER=sender@example.com
# An omitted provider also supports existing Resend key/from configuration.

STRIPE_SECRET_KEY=
# Two separate active one-time prices: exactly EUR 4.99 and USD 4.99 (499 minor units).
# Country suggests the initial currency; the player can choose EUR or USD.
# Checkout disables Adaptive Pricing and uses the selected fixed price.
STRIPE_PRICE_ID_EUR=
STRIPE_PRICE_ID_USD=
# Legacy single-price fallback, used only when both currency-specific IDs are empty.
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# NRN Plus: BMC hosted recurring memberships. Disabled until the actual level,
# signed lifecycle, monthly/yearly prices, no-trial setting and refund procedure
# have been checked. BMC is the authority of access, including its payment grace;
# a membership update is not represented as an individual paid invoice receipt.
PLUS_PROVIDER=disabled
BMC_WEBHOOK_SECRET=
BMC_MEMBERSHIP_LEVEL_ID=
BMC_MEMBERSHIP_CURRENCY=usd
BMC_MEMBERSHIP_URL=https://buymeacoffee.com/nrnplay/membership
# Buyer's actual account/payments page, not the creator administration page.
BMC_MANAGEMENT_URL=
# Record actual signed test payload units: major (10/1) or minor (1000/100).
# Readiness only: access trusts the signed level/state/period, never an FX calculation.
BMC_AMOUNT_UNITS=
# BMC currently exposes both monthly and yearly pricing on a membership level.
# The approved NRN Plus level has base USD 1/month or USD 10/year. BMC may
# localize currency or accept higher contributions; signed positive amounts qualify.
# Explicit signed lifetime-giveaway events may grant zero-price complimentary
# access for a finite provider period of at most five calendar years. Ordinary
# month/year zero amounts remain rejected; the approved paid level has no trial.
BMC_MONTHLY_AMOUNT_MINOR=100
BMC_VALIDATION_CONFIRMED=false
# BMC publishes no membership.refunded webhook. Refund/revoke is an owner workflow.
BMC_REFUND_MODE=manual
# Billing requires the existing external durable DATABASE_URL; never Render's local disk.

ADS_PROVIDER=disabled
ADSENSE_PUBLISHER_ID=
# Only after approval, a real certified CMP, matching client flags and hosted QA.
# This acknowledgement does not install a CMP or establish consent for a player.
ADS_CONSENT_READY=false

# Only after verifying the actual proxy topology:
# MEMBERSHIP_TRUST_PROXY_HOPS=1
