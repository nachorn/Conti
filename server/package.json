{
  "name": "continental-rummy-server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "postinstall": "node scripts/fix-pocha-imports.cjs",
    "build": "node scripts/fix-pocha-imports.cjs && tsc",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "deploy": "npm run build && npm start"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "pg": "^8.23.0",
    "proper-lockfile": "^4.1.2",
    "socket.io": "^4.8.4",
    "ts-trueskill": "5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/proper-lockfile": "^4.1.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "engine.io": "6.6.11",
    "body-parser": "1.20.9",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "mathjs": "15.2.0"
  }
}
