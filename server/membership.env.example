# Example only. Set real values in the game server environment, never VITE_*.
# Leave features disabled until Gmail authorization, both prices and consent are validated.
MEMBERSHIP_ENABLED=false
MEMBERSHIP_AUTH_SECRET=
PUBLIC_APP_URL=https://conti-six.vercel.app

# Reuse the existing durable DATABASE_URL and private ADMIN_DASHBOARD_KEY.
# Optional persistent file alternative (must differ from GAME_STATE_PATH):
# MEMBERSHIP_STATE_PATH=/data/memberships.json

# Gmail sends from the owner's authorized mailbox over HTTPS (not SMTP).
# Authorize only https://www.googleapis.com/auth/gmail.send with offline access.
# External OAuth apps in Testing receive refresh tokens that expire after 7 days.
MEMBERSHIP_EMAIL_PROVIDER=gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The same plain mailbox that authorizes OAuth; example: sender@example.com.
GMAIL_SENDER=

# Optional legacy provider, only when MEMBERSHIP_EMAIL_PROVIDER=resend.
# An omitted provider also supports existing RESEND_API_KEY + MEMBERSHIP_EMAIL_FROM.
# RESEND_API_KEY=
# MEMBERSHIP_EMAIL_FROM=

STRIPE_SECRET_KEY=
# Two separate active one-time prices: exactly EUR 4.99 and USD 4.99 (499 minor units).
# Country suggests the initial currency; the player can choose EUR or USD.
# Checkout disables Adaptive Pricing and uses the selected fixed price.
STRIPE_PRICE_ID_EUR=
STRIPE_PRICE_ID_USD=
# Legacy single-price fallback, used only when both currency-specific IDs are empty.
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

ADS_PROVIDER=disabled
ADSENSE_PUBLISHER_ID=

# Only after verifying the actual proxy topology:
# MEMBERSHIP_TRUST_PROXY_HOPS=1
