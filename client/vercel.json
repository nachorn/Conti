{
  "redirects": [
    { "source": "/account", "has": [{ "type": "host", "value": "www.nrnplay.com" }], "destination": "https://nrnplay.com/account", "permanent": false }
  ],
  "headers": [
    {
      "source": "/account",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/connect",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/game",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/room/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "functions": {
    "api/editorial.js": { "includeFiles": "public/learn/**" }
  },
  "routes": [
    {
      "src": "^/learn/(es|en)/(continental|pocha)/?$",
      "dest": "/api/editorial?lang=$1&game=$2"
    },
    {
      "src": "^/api/editorial$",
      "dest": "/api/editorial"
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://va.vercel-scripts.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.nrnplay.com wss://api.nrnplay.com https://conti-server.onrender.com wss://conti-server.onrender.com https://vitals.vercel-insights.com https://vitals.vercel-analytics.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "conti.nrnplay.com" }],
      "dest": "/conti/index.html"
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "pocha.nrnplay.com" }],
      "dest": "/pocha/index.html"
    }
  ],
  "rewrites": [
    { "source": "/account", "destination": "/index.html" },
    {
      "source": "/api/admin/:path*",
      "destination": "https://api.nrnplay.com/api/admin/:path*"
    },
    {
      "source": "/connect",
      "destination": "/index.html"
    },
    {
      "source": "/conti",
      "destination": "/conti/index.html"
    },
    {
      "source": "/pocha",
      "destination": "/pocha/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/"
    },
    {
      "source": "/room/:roomId",
      "destination": "/"
    },
    {
      "source": "/game",
      "destination": "/"
    }
  ]
}

