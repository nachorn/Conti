# Public browser configuration. Never place private keys here.
VITE_SOCKET_URL=https://conti-server.onrender.com

# Turn on after all three subdomains resolve and HTTPS is verified.
# Until then the existing /conti, /pocha and footballchampion.net links work.
VITE_GAME_SUBDOMAINS_ENABLED=false

# Central account entry. For local SSO testing use http://localhost:5173.
VITE_NRN_AUTH_URL=https://nrnplay.com

# Advertising stays off until approval, a real certified CMP and hosted QA.
# See ADVERTISING.md. These flags do not install a CMP or grant approval.
VITE_ADS_CONSENT_READY=false
VITE_ADS_CMP=disabled
