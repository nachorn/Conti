# Abbreviated proposal, not a replacement of the complete private live env.
NODE_ENV=production
NODE_OPTIONS="--max-old-space-size=192"
NRN_STORAGE_MODE=file
GAME_STATE_PATH=/var/lib/nrnplay/games.json
MEMBERSHIP_STATE_PATH=/var/lib/nrnplay/memberships.json
PORT=3001
LISTEN_HOST=127.0.0.1
MEMBERSHIP_TRUST_PROXY_HOPS=1
MEMBERSHIP_ENABLED=true
PUBLIC_APP_URL=https://nrnplay.com
NRN_PASSWORD_WORKER_URL=https://conti-server.onrender.com
RACE_CGROUP_MEMORY_PATH=/sys/fs/cgroup/system.slice/actions.runner.nachorn-race-golf-scheduler.race-golf-azure-belgium.service/memory.current
NRN_RACE_MEMORY_THRESHOLD_MB=300
NRN_MIN_AVAILABLE_MEMORY_MB=256
# Preserve existing CLIENT_ORIGINS, game origins, account auth key, anti-bot,
# email, Plus/BMC, cosmetics, ads and admin settings. Never regenerate auth.
# Preserve existing DATABASE_URL privately: Plus/BMC currently checks its presence.
# File mode MUST ignore it for storage and never open a runtime PG connection.
